# ==============================================================================
# New Career — Configuração de Ambiente (.env.example)
# Copie este ficheiro para `.env` na raiz do projeto e preencha os valores.
# ==============================================================================

# Ambiente da aplicação: development | production
APP_ENV=development

# Segurança JWT (OBRIGATÓRIO alterar em produção; gere com: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me-in-production-use-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# Chave opcional para encriptação em repouso de API Keys do utilizador (Fernet base64 de 32 bytes; se omitida, deriva de JWT_SECRET)
SETTINGS_ENCRYPTION_KEY=

# CORS (origens separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Armazenamento e Base de Dados
STORAGE_DIR=./storage
DATABASE_URL=sqlite+aiosqlite:///./new_career.db

# Firebase / Firestore (opcional — sem credenciais usa storage/local_firestore.json)
USE_FIREBASE=true
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIREBASE_PROJECT_ID=

# Onboarding: permitir importação de diretórios locais do servidor (desativar em VPS pública)
ALLOW_LOCAL_DIR_IMPORT=false

# Provedores de IA (opcionais — utilizadores também podem configurar na UI em Configurações)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Scrapers & Geolocalização
SERPAPI_API_KEY=
JSEARCH_API_KEY=
DEFAULT_CITIES=Lisboa, Porto, Coimbra, Braga, Aveiro, Remoto
DEFAULT_KEYWORDS=Software Engineer, Desenvolvedor Python, Full Stack, Frontend, Data Engineer
DEFAULT_CITY=Lisboa
DEFAULT_COUNTRY=Portugal
MAX_DISTANCE_KM=25.0

# Frontend (Vite)
VITE_API_URL=http://localhost:8000/api
